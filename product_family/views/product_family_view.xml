<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record model="ir.ui.view" id="product_family_tree_view">
            <field name="name">product.family.tree</field>
            <field name="model">product.family</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Product Family">
                    <field name="name" />
                    <field name="parent_family_id" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="product_family_form_view">
            <field name="name">product.family.form</field>
            <field name="model">product.family</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Product Family">
                    <group colspan="4" col="6">
                        <separator string="Product Family" colspan="6" />
                        <field name="name" select="1" />
                        <field name="parent_family_id" select="1" domain="['!',('name','=ilike',name)]" />
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_product_family_tree_view">
            <field name="name">Product Family</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.family</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="product_family_tree_view" />
        </record>

        <menuitem id="product_family_menu" name="Product Family"
            parent="stock.menu_stock_config_settings" action="action_product_family_tree_view" />
</odoo>
